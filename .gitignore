# Secrets and generated env
server.env

# Downloaded pack archives (verified via server.env PACK_SHA256, not tracked)
downloads/

# Generated server runtime content (reproduced by install.sh from the pinned pack)
server/world/
server/logs/
server/crash-reports/
server/libraries/
server/mods/
server/server.properties
server/eula.txt
server/*.jar
server/whitelist.json
server/usercache.json
server/banned-*.json
server/ops.json

# server/config/ is intentionally NOT ignored — small text, operator-edited,
# and Phase 3's client manifest generator reads it as source of truth.

# RLCraft server pack noise (regenerable from pinned zip)
server/.mixin.out/
server/*.txt
server/*.log
server/llibrary/
server/resourcepacks/
server/resources/
server/scripts/
server/structures/

# runtime-regenerated dumps
server/config/fantasticlib/reference/

# WR-01: flock guard used by backup.sh/restore.sh to prevent concurrent runs
.backup.lock

# campfire-auth (Phase 2): Rust build output (Cargo.lock IS tracked, the
# lockfile is the supply-chain pin) and the runtime accounts database
# (D-13: mode 600, contains argon2id hashes, lives outside the repo tree).
auth-service/target/
# Anchored to repo root (Rule 1 fix, 02-02): an unanchored "auth/" also
# matched mods-src/campfire-auth/src/main/java/pub/campfire/auth/ — a
# directory of the mod's own java package, silently hiding its sources
# from git add.
/auth/

# campfire-auth mod (02-02): Gradle/ForgeGradle build output and the
# decompile workspace — regenerated by build.sh, never tracked. The
# wrapper jar/properties and all sources stay tracked.
mods-src/campfire-auth/build/
mods-src/campfire-auth/.gradle/
mods-src/campfire-auth/run/

# Throwaway devserver (02-02 Task 2) — disposable, gitignored, safe to delete.
devserver/
__pycache__/

# ca/ (Phase 3): the root CA private key. Never committed — anyone holding
# this can mint a certificate every Phase 4 launcher will trust.
ca/campfire-ca-key.pem
# ca/ (Phase 3): the leaf private key, named after DOMAIN (e.g.
# mc.campfire.pub-key.pem). Never committed — Caddy needs it on disk, git
# never does.
ca/*-key.pem
# ca/ (Phase 3): the leaf certificate, named after DOMAIN. Not committed —
# regenerable from the CA at any time via scripts/renew-cert.sh; only the CA
# public cert (ca/campfire-ca.pem, tracked below) needs to be portable.
ca/*-cert.pem
# ca/ (Phase 3): OpenSSL's serial-number bookkeeping file, written by
# -CAcreateserial. No secret and no useful history — regenerated every run.
ca/*.srl

# pack/ (Phase 3): gitignored staging tree written by scripts/publish-pack.sh
# (plan 03-02) — hundreds of megabytes, fully reproducible from the manifest
# sources, never meant to be tracked.
pack/

# A stray manually-downloaded Caddy .deb from an earlier attempt at this repo
# root — not used by this project (the official apt repo is used instead via
# scripts/install-caddy.sh). Left on disk, not tracked.
/caddy_*.deb
