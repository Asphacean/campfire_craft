{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Campfire-Launcher",
  "version": "0.1.0",
  "identifier": "pub.campfire.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "campfire.pub",
        "width": 480,
        "height": 560,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mc.campfire.pub:8444/launcher/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBOTdBRjg4MTUyMTEzRDIKUldUU0V5RVZpSytYZXZpblNrbU9mb25QMW5CSklHR2RkcEUwSEpmSmc5ZjdrT1Q4WkgzeUdYSDMK"
    }
  }
}
