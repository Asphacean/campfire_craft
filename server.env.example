# Tracked template for server.env — every key every script reads (D-15).
# Copy to server.env (scripts/preflight.sh does this automatically on first run),
# never commit the real server.env (it is gitignored, mode 600).

# Domain/subdomain friends type to join. Placeholder until the operator supplies
# the real one at the Task 3 checkpoint.
DOMAIN=mc.example.com

# server.properties motd / server name (operator-supplied at the Task 3 checkpoint).
SERVER_NAME=

# Comma-separated in-game nicknames allowed to join. Only enforced if
# WHITELIST_ENABLED=true below.
WHITELIST_NICKS=

# Whether server.properties renders white-list=true / enforce-whitelist=true.
# CONTEXT.md D-09 default is true; the operator may decline a whitelist for
# Phase 1 (accepting open access until Phase 2's token auth) — see
# 01-01-SUMMARY.md for the deviation record when set to false.
WHITELIST_ENABLED=true

# Absolute path to the Temurin 8 java binary. Resolved and written by scripts/preflight.sh.
JAVA8_BIN=

# --- SRV-05 tuning ladder (D-13) ---
# If the 3-player, 20-minute load test (`scripts/tps-log.sh 20m 30s`) reports
# median Overall TPS under 15, apply these in order, restarting and
# re-testing after each rung before moving to the next:
#   1. Raise HEAP below from 6G to 8G, `sudo systemctl restart rlcraft`.
#      8G is the ceiling — the Pi's other services need the remainder of its
#      15G total RAM. Before bumping this, confirm nothing else large is
#      running: `-XX:+AlwaysPreTouch` (Aikar's flags) commits the *whole*
#      heap at JVM startup, not lazily, so an 8G heap means 8G is reserved
#      the instant the server starts, not as it fills up.
#   2. Drop VIEW_DISTANCE below to 6, re-render with
#      `scripts/install.sh --config-only` (rewrites server.properties'
#      view-distance key only — does not re-run the Forge installer or
#      touch server/mods/), `sudo systemctl restart rlcraft`.
#   3. Only after both of the above: RLCraft-safe config tweaks (mob caps,
#      simulation tuning inside server/config/) — no specific values locked
#      in advance; see RESEARCH.md Pitfall 1/5 for the CPU-bound-not-RAM-
#      bound background on why 1 and 2 are tried before touching mod configs.
# JVM heap size for -Xms/-Xmx (D-05). Bump to 8G only if the SRV-05 load test demands it.
HEAP=6G

# Path to the Forge server jar once installed (set by a later plan's install.sh).
SERVER_JAR=

# RCON connection info. Bound to loopback only (D-08).
RCON_HOST=127.0.0.1
RCON_PORT=25575
# CSPRNG-generated by scripts/preflight.sh on first run — never hand-type this.
RCON_PASSWORD=

# Pin for the RLCraft Server Pack 2.9.3 zip (D-03). Empty until scripts/fetch-pack.sh
# does a trust-on-first-use capture; then every later run verifies against this hash.
PACK_SHA256=
# Absolute path to the verified pack zip on local disk.
PACK_ZIP=

# Optional CurseForge API key (console.curseforge.com) — only needed if the
# unauthenticated CDN download path is refused. See scripts/fetch-pack.sh.
CF_API_KEY=

# Backup retention (D-10).
BACKUP_DIR=/home/asphacean/rlcraft-backups
BACKUP_KEEP=14

# server.properties tuning (D-12). See the SRV-05 tuning ladder above HEAP —
# view-distance is rung 2, tried only after HEAP=8G.
VIEW_DISTANCE=8
MAX_PLAYERS=10

# CGNAT check results (D-07, D-16) — written by scripts/cgnat-check.sh as
# detected|absent|unknown-needs-router-ip. May be hand-amended to
# likely-clear-unconfirmed when the operator confirms a static, non-CGNAT-range
# public IP without supplying the router WAN IP (see 01-01-SUMMARY.md).
PUBLIC_IP_AT_SETUP=
CGNAT_VERDICT=

# Operator-supplied facts about the WAN connection (filled at the Task 3 checkpoint).
WAN_IP_KIND=
DDNS_PROVIDER=
DDNS_API_TOKEN=
DDNS_ZONE_ID=

# --- campfire-auth (Phase 2) ---
# campfire-auth.service reads these via EnvironmentFile (never interpolated
# onto its ExecStart line — same CR-01 reasoning as RCON_PASSWORD above).
# The binary itself refuses to start on any non-loopback AUTH_BIND (D-16);
# this is a defense-in-depth value, not the only enforcement point.
AUTH_BIND=127.0.0.1:8081
# Accounts database (D-13): directory mode 700, file mode 600, gitignored.
# scripts/backup.sh snapshots it into the six-hourly world archive.
AUTH_DB=/home/asphacean/rlcraft/auth/campfire.db

# --- Modpack distribution (Phase 3) ---
# HTTPS listener port for Caddy (mc.campfire.pub:$HTTPS_PORT). caddy/Caddyfile
# carries this as an absolute literal — it is read by a service that does not
# source server.env — so scripts/install-caddy.sh asserts the two agree.
HTTPS_PORT=8444
# Absolute path to the gitignored pack staging tree Caddy serves as
# /manifest.json and /pack/*. caddy/Caddyfile carries this as an absolute
# literal too; scripts/install-caddy.sh asserts they agree.
PACK_DIR=/home/asphacean/rlcraft/pack
# Absolute path to the CA/leaf certificate directory. caddy/Caddyfile's `tls`
# directive names the leaf cert/key under here by absolute path.
CA_DIR=/home/asphacean/rlcraft/ca
