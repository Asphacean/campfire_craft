# Tracked template for server.env — every key every script reads (D-15).
# Copy to server.env (scripts/preflight.sh does this automatically on first run),
# never commit the real server.env (it is gitignored, mode 600).

# Domain/subdomain friends type to join. Placeholder until the operator supplies
# the real one at the Task 3 checkpoint.
DOMAIN=mc.example.com

# server.properties motd / server name (operator-supplied at the Task 3 checkpoint).
SERVER_NAME=

# Comma-separated in-game nicknames allowed to join. Only enforced if
# WHITELIST_ENABLED=true below.
WHITELIST_NICKS=

# Whether server.properties renders white-list=true / enforce-whitelist=true.
# CONTEXT.md D-09 default is true; the operator may decline a whitelist for
# Phase 1 (accepting open access until Phase 2's token auth) — see
# 01-01-SUMMARY.md for the deviation record when set to false.
WHITELIST_ENABLED=true

# Absolute path to the Temurin 8 java binary. Resolved and written by scripts/preflight.sh.
JAVA8_BIN=

# JVM heap size for -Xms/-Xmx (D-05). Bump to 8G only if the SRV-05 load test demands it.
HEAP=6G

# Path to the Forge server jar once installed (set by a later plan's install.sh).
SERVER_JAR=

# RCON connection info. Bound to loopback only (D-08).
RCON_HOST=127.0.0.1
RCON_PORT=25575
# CSPRNG-generated by scripts/preflight.sh on first run — never hand-type this.
RCON_PASSWORD=

# Pin for the RLCraft Server Pack 2.9.3 zip (D-03). Empty until scripts/fetch-pack.sh
# does a trust-on-first-use capture; then every later run verifies against this hash.
PACK_SHA256=
# Absolute path to the verified pack zip on local disk.
PACK_ZIP=

# Optional CurseForge API key (console.curseforge.com) — only needed if the
# unauthenticated CDN download path is refused. See scripts/fetch-pack.sh.
CF_API_KEY=

# Backup retention (D-10).
BACKUP_DIR=/home/asphacean/rlcraft-backups
BACKUP_KEEP=14

# server.properties tuning (D-12).
VIEW_DISTANCE=8
MAX_PLAYERS=10

# CGNAT check results (D-07, D-16) — written by scripts/cgnat-check.sh as
# detected|absent|unknown-needs-router-ip. May be hand-amended to
# likely-clear-unconfirmed when the operator confirms a static, non-CGNAT-range
# public IP without supplying the router WAN IP (see 01-01-SUMMARY.md).
PUBLIC_IP_AT_SETUP=
CGNAT_VERDICT=

# Operator-supplied facts about the WAN connection (filled at the Task 3 checkpoint).
WAN_IP_KIND=
DDNS_PROVIDER=
DDNS_API_TOKEN=
DDNS_ZONE_ID=
