[Unit]
Description=RLCraft dedicated server (Forge 1.12.2 on Temurin 8)
After=network-online.target
Wants=network-online.target
# WR-02: both this unit and rlcraft-nft.service are WantedBy=multi-user.target
# with no ordering between them, so systemd is free to start them in parallel
# at boot — RCON could be listening before the D-08 drop rule loads. Force the
# firewall rule to load first.
After=rlcraft-nft.service
Wants=rlcraft-nft.service

[Service]
Type=simple
User=asphacean
WorkingDirectory=/home/asphacean/rlcraft/server
EnvironmentFile=/home/asphacean/rlcraft/server.env
ExecStart=/home/asphacean/rlcraft/scripts/start-server.sh
# Leading `-` (systemd "ignore this executable's exit code" syntax): if RCON
# happens to be unreachable at stop time (e.g. the server is still mid-boot
# from a just-completed restart), the graceful stop attempt itself must not
# turn a `systemctl stop` into a unit-level "failed" result — KillMode=mixed
# below still delivers SIGTERM to the JVM either way. Found live during
# 01-03 Task 2 restore testing: an unprefixed ExecStop marked the unit
# "failed" on a mid-boot stop attempt (Result: exit-code) instead of a clean
# stop. See 01-03-SUMMARY.md Deviations.
# CR-01: RCON_HOST/RCON_PORT/RCON_PASSWORD are already in this unit's process
# environment via EnvironmentFile= above — rcon-cli reads them from there, so
# they must never be interpolated onto this command line (systemd would
# otherwise expand ${RCON_PASSWORD} into argv, visible via ps/proc to any
# local user).
ExecStop=-/usr/local/bin/rcon-cli stop
KillMode=mixed
TimeoutStopSec=90
Restart=on-failure
RestartSec=15
SuccessExitStatus=0 143

[Install]
WantedBy=multi-user.target
